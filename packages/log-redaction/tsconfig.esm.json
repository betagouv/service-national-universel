{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "outDir": "./dist/esm",
    "tsBuildInfoFile": null
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/node_modules/*", "src/__tests__/*"]
}
